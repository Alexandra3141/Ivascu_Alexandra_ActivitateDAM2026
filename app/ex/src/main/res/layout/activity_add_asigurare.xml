<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/ivascu_alexandra_etId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_id_asigurare"
        android:inputType="number" />

    <EditText
        android:id="@+id/ivascu_alexandra_etTitular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_titular"
        android:inputType="text" />

    <EditText
        android:id="@+id/ivascu_alexandra_etCost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_cost_polita"
        android:inputType="numberDecimal" />

    <Spinner
        android:id="@+id/ivascu_alexandra_spTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <CheckBox
        android:id="@+id/ivascu_alexandra_cbActivata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_este_activata" />

    <Button
        android:id="@+id/ivascu_alexandra_btnSalvare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/btn_salvare" />

</LinearLayout>
